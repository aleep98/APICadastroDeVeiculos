{
  "openapi": "3.0.1",
  "info": {
    "title": "API Cadastro de Veículos",
    "version": "1.0.0",
    "description": "API REST para gerenciamento de veículos e usuários. Autenticação por JWT e refresh tokens."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "Veiculo": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "placa": { "type": "string" },
          "modelo": { "type": "string" },
          "cor": { "type": "string" },
          "ano": { "type": "integer" },
          "proprietario": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register user (creates access + refresh tokens)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login (returns access token and sets refresh cookie)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } }, "required": ["email","password"] } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token and return new access token",
        "responses": { "200": { "description": "New access token" } }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout and revoke refresh token",
        "responses": { "200": { "description": "Logged out" } }
      }
    },
    "/veiculos": {
      "post": {
        "summary": "Create vehicle",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Veiculo" } } } },
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List vehicles (requires bearer token)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/veiculos/{id}": {
      "get": {
        "summary": "Get vehicle by id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Update vehicle",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Veiculo" } } } },
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "summary": "Delete vehicle",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    }
  }
}
